<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same rule as backup_rules.xml: SMTP accounts are never backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/smtp_accounts.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/smtp_accounts.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
